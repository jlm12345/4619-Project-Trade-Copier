        private void KillEmAll()
        {
            try
            {
                SuspendCopierForKill();

                lock (Account.All)
                {
                    killAccounts =
                        Account.All
                            .Where(a => a != null)
                            .ToList();
                }

                Log(
                    "KILL 'EM ALL ACTIVATED.");

                foreach (
                    Account account
                    in killAccounts)
                {
                    try
                    {
                        List<Order> activeOrders;

                        lock (account.Orders)
                        {
                            activeOrders =
                                account.Orders
                                    .Where(o =>
                                        o != null
                                        &&
                                        !IsTerminal(o.OrderState))
                                    .ToList();
                        }

                        if (activeOrders.Count > 0)
                        {
                            account.Cancel(activeOrders);

                            Log(
                                "CANCEL ALL SENT: "
                                + account.Name
                                + " ("
                                + activeOrders.Count
                                + " ORDERS)");
                        }
                    }
                    catch (Exception ex)
                    {
                        Log(
                            "KILL CANCEL ERROR "
                            + account.Name
                            + ": "
                            + ex.Message);
                    }
                }

                if (killTimer != null)
                {
                    killTimer.Stop();

                    killTimer.Tick -=
                        KillTimer_Tick;
                }

                killTimer =
                    new DispatcherTimer
                    {
                        Interval =
                            TimeSpan.FromMilliseconds(50)
                    };

                killTimer.Tick +=
                    KillTimer_Tick;

                killTimer.Start();
            }
            catch (Exception ex)
            {
                Log(
                    "KILL ERROR: "
                    + ex.Message);
            }
        }

        private void SuspendCopierForKill()
        {
            if (leaderAccount != null)
            {
                leaderAccount.OrderUpdate -=
                    LeaderAccount_OrderUpdate;

                leaderAccount.ExecutionUpdate -=
                    LeaderAccount_ExecutionUpdate;
            }

            foreach (
                FollowerSetting setting
                in followerSettings.Values)
            {
                if (
                    setting != null
                    &&
                    setting.Account != null)
                {
                    setting.Account.ExecutionUpdate -=
                        FollowerAccount_ExecutionUpdate;
                }
            }

            copierRunning =
                false;

            leaderComboBox.IsEnabled =
                true;

            startButton.IsEnabled =
                true;

            stopButton.IsEnabled =
                false;

            SetFollowerControlsEnabled(true);

            if (statusText != null)
            {
                statusText.Text =
                    "LOITERING...";
            }
        }
        private void KillTimer_Tick(object sender, EventArgs e)
        {
            bool anyActiveOrders = false;

            foreach (Account account in killAccounts.ToList())
            {
                try
                {
                    lock (account.Orders)
                    {
                        if (account.Orders.Any(o =>
                            o != null &&
                            !IsTerminal(o.OrderState)))
                        {
                            anyActiveOrders = true;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Log("KILL WAIT ERROR " +
                        account.Name + ": " + ex.Message);

                    anyActiveOrders = true;
                }
            }

            if (anyActiveOrders)
                return;

            if (killTimer != null)
            {
                killTimer.Stop();
                killTimer.Tick -= KillTimer_Tick;
                killTimer = null;
            }

            foreach (Account account in killAccounts.ToList())
            {
                try
                {
                    Collection<Instrument> instruments =
                        new Collection<Instrument>();

                    lock (account.Positions)
                    {
                        foreach (Position position in account.Positions)
                        {
                            if (position == null ||
                                position.Instrument == null ||
                                position.MarketPosition == MarketPosition.Flat)
                                continue;

                            if (!instruments.Contains(position.Instrument))
                            {
                                instruments.Add(position.Instrument);
                            }
                        }
                    }

                    if (instruments.Count > 0)
                    {
                        account.Flatten(instruments);

                        Log("FLATTEN ALL SENT: " + account.Name);
                    }
                }
                catch (Exception ex)
                {
                    Log("KILL FLATTEN ERROR " +
                        account.Name + ": " + ex.Message);
                }
            }

            Log("KILL 'EM ALL COMMANDS SENT. " +
                "COPIER REMAINS LOITERING.");
        }

        private List<FollowerSetting> GetEnabledFollowers()
        {
            return followerSettings.Values
                .Where(f =>
                    f != null &&
                    f.CopyCheckBox != null &&
                    f.CopyCheckBox.IsChecked == true)
                .ToList();
        }

        private List<FollowerSetting> GetEnabledFollowersThreadSafe()
        {
            List<FollowerSetting> result = null;

            if (Dispatcher.CheckAccess())
            {
                result = GetEnabledFollowers();
            }
            else
            {
                Dispatcher.Invoke(new Action(() =>
                {
                    result = GetEnabledFollowers();
                }));
            }

            return result ?? new List<FollowerSetting>();
        }

        private int GetMultiplier(FollowerSetting setting)
        {
            int result = 1;

            if (setting == null ||
                setting.MultiplierTextBox == null)
                return result;

            string text = null;

            if (Dispatcher.CheckAccess())
            {
                text = setting.MultiplierTextBox.Text;
            }
            else
            {
                Dispatcher.Invoke(new Action(() =>
                {
                    text = setting.MultiplierTextBox.Text;
                }));
            }

            if (!int.TryParse(text, out result) ||
                result < 1)
            {
                result = 1;
            }

            return result;
        }

        private void SetFollowerControlsEnabled(bool enabled)
        {
            foreach (FollowerSetting setting in followerSettings.Values)
            {
                if (setting == null)
                    continue;

                if (setting.CopyCheckBox != null)
                    setting.CopyCheckBox.IsEnabled = enabled;

                if (setting.MultiplierTextBox != null)
                    setting.MultiplierTextBox.IsEnabled = enabled;
            }
        }

        private bool IsTerminal(OrderState state)
        {
            return state == OrderState.Cancelled ||
                   state == OrderState.Filled ||
                   state == OrderState.Rejected;
        }

