        private void RefreshAccounts()
        {
            try
            {
                List<Account> snapshot;

                lock (Account.All)
                {
                    snapshot =
                        Account.All
                            .Where(
                                a =>
                                    a != null)
                            .OrderBy(
                                a => a.Name)
                            .ToList();
                }

                accounts =
                    snapshot;

                string previousLeader =
                    leaderComboBox.SelectedItem
                    as string;

                leaderComboBox.ItemsSource =
                    null;

                leaderComboBox.ItemsSource =
                    accounts
                        .Select(
                            a => a.Name)
                        .ToList();

                string leaderToSelect =
                    null;

                Account sim101 =
                    accounts.FirstOrDefault(
                        a =>
                            string.Equals(
                                a.Name,
                                "Sim101",
                                StringComparison.OrdinalIgnoreCase));

                if (sim101 != null)
                {
                    leaderToSelect =
                        sim101.Name;
                }

                else if (
                    !string.IsNullOrEmpty(
                        previousLeader)
                    &&
                    accounts.Any(
                        a =>
                            a.Name ==
                            previousLeader))
                {
                    leaderToSelect =
                        previousLeader;
                }

                else if (
                    accounts.Count > 0)
                {
                    leaderToSelect =
                        accounts[0].Name;
                }

                leaderComboBox.SelectedItem =
                    leaderToSelect;

                RebuildFollowerRows();

                Log(
                    "Accounts refreshed. Found "
                    +
                    accounts.Count
                    +
                    " account(s).");

                if (
                    !string.IsNullOrEmpty(
                        leaderToSelect))
                {
                    Log(
                        "Leader selected: "
                        +
                        leaderToSelect);
                }
            }

            catch (Exception ex)
            {
                Log(
                    "REFRESH ERROR: "
                    +
                    ex.Message);
            }
        }

