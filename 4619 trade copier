        private void StartCopier()
        {
            if (copierRunning)
                return;

            string leaderName =
                leaderComboBox.SelectedItem
                as string;

            if (string.IsNullOrEmpty(leaderName))
            {
                Log(
                    "START ERROR: No leader account selected.");

                return;
            }

            leaderAccount =
                accounts.FirstOrDefault(
                    a =>
                        a.Name == leaderName);

            if (leaderAccount == null)
            {
                Log(
                    "START ERROR: Leader account not found.");

                return;
            }

            List<FollowerSetting> enabledFollowers =
                GetEnabledFollowers();

            if (enabledFollowers.Count == 0)
            {
                Log(
                    "START ERROR: Select at least one follower.");

                return;
            }

            foreach (
                FollowerSetting setting
                in enabledFollowers)
            {
                int multiplier;

                if (
                    !int.TryParse(
                        setting.MultiplierTextBox.Text,
                        out multiplier)
                    ||
                    multiplier < 1)
                {
                    Log(
                        "START ERROR: Invalid multiplier for "
                        +
                        setting.Account.Name);

                    return;
                }

                if (
                    setting.Account.Connection == null
                    ||
                    setting.Account.Connection.Status
                        != ConnectionStatus.Connected)
                {
                    Log(
                        "START ERROR: Follower not connected: "
                        +
                        setting.Account.Name);

                    return;
                }
            }

            if (
                leaderAccount.Connection == null
                ||
                leaderAccount.Connection.Status
                    != ConnectionStatus.Connected)
            {
                Log(
                    "START ERROR: Master account not connected.");

                return;
            }

            lock (syncLock)
            {
                copiedOrders.Clear();
                followerOcoMap.Clear();
                followerOrderLookup.Clear();
                executionTrackers.Clear();
            }

            ResetLatencyCounters();

            leaderAccount.OrderUpdate -=
                LeaderAccount_OrderUpdate;

            leaderAccount.OrderUpdate +=
                LeaderAccount_OrderUpdate;

            leaderAccount.ExecutionUpdate -=
                LeaderAccount_ExecutionUpdate;

            leaderAccount.ExecutionUpdate +=
                LeaderAccount_ExecutionUpdate;

            foreach (
                FollowerSetting setting
                in enabledFollowers)
            {
                setting.Account.ExecutionUpdate -=
                    FollowerAccount_ExecutionUpdate;

                setting.Account.ExecutionUpdate +=
                    FollowerAccount_ExecutionUpdate;
            }

            copierRunning =
                true;

            leaderComboBox.IsEnabled =
                false;

            startButton.IsEnabled =
                false;

            stopButton.IsEnabled =
                true;

            SetFollowerControlsEnabled(false);

            statusText.Text =
                "WEALTH BUILDING IN PROCESS...";

            Log(
                "COPIER STARTED.");

            Log(
                "Leader: "
                +
                leaderAccount.Name);

            foreach (
                FollowerSetting setting
                in enabledFollowers)
            {
                Log(
                    "Follower enabled: "
                    +
                    setting.Account.Name
                    +
                    "  x"
                    +
                    setting.MultiplierTextBox.Text);
            }
        }

