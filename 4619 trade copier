        private void StopCopier()
        {
            if (killTimer != null)
            {
                killTimer.Stop();

                killTimer.Tick -=
                    KillTimer_Tick;

                killTimer =
                    null;
            }

            killAccounts.Clear();

            if (leaderAccount != null)
            {
                leaderAccount.OrderUpdate -=
                    LeaderAccount_OrderUpdate;

                leaderAccount.ExecutionUpdate -=
                    LeaderAccount_ExecutionUpdate;
            }

            foreach (
                FollowerSetting setting
                in followerSettings.Values)
            {
                if (
                    setting != null
                    &&
                    setting.Account != null)
                {
                    setting.Account.ExecutionUpdate -=
                        FollowerAccount_ExecutionUpdate;
                }
            }

            lock (syncLock)
            {
                copiedOrders.Clear();
                followerOcoMap.Clear();
                followerOrderLookup.Clear();
                executionTrackers.Clear();
            }

            copierRunning =
                false;

            leaderComboBox.IsEnabled =
                true;

            startButton.IsEnabled =
                true;

            stopButton.IsEnabled =
                false;

            SetFollowerControlsEnabled(true);

            if (statusText != null)
            {
                statusText.Text =
                    string.Empty;
            }

            if (logTextBox != null)
            {
                Log(
                    "COPIER STOPPED.");
            }

            leaderAccount =
                null;
        }

        private void LeaderAccount_OrderUpdate(
            object sender,
            OrderEventArgs e)
        {
            if (
                !copierRunning
                ||
                e == null
                ||
                e.Order == null)
            {
                return;
            }

            Order leaderOrder =
                e.Order;

            if (
                leaderAccount == null
                ||
                leaderOrder.Account != leaderAccount)
            {
                return;
            }

            try
            {
                bool alreadyCopied;

                lock (syncLock)
                {
                    alreadyCopied =
                        copiedOrders.ContainsKey(
                            leaderOrder);
                }

                if (!alreadyCopied)
                {
                    if (
                        e.OrderState == OrderState.Submitted
                        ||
                        e.OrderState == OrderState.Accepted
                        ||
                        e.OrderState == OrderState.Working
                        ||
                        e.OrderState == OrderState.TriggerPending
                        ||
                        e.OrderState == OrderState.PartFilled)
                    {
                        CopyNewLeaderOrder(
                            leaderOrder);

                        return;
                    }
                }

                if (!alreadyCopied)
                    return;

                if (
                    e.OrderState == OrderState.CancelPending
                    ||
                    e.OrderState == OrderState.CancelSubmitted
                    ||
                    e.OrderState == OrderState.Cancelled)
                {
                    CancelFollowerOrders(
                        leaderOrder);

                    return;
                }

                if (
                    e.OrderState == OrderState.ChangePending
                    ||
                    e.OrderState == OrderState.ChangeSubmitted
                    ||
                    e.OrderState == OrderState.Working
                    ||
                    e.OrderState == OrderState.Accepted)
                {
                    ChangeFollowerOrders(
                        leaderOrder);
                }
            }

            catch (Exception ex)
            {
                LogThreadSafe(
                    "ORDER UPDATE ERROR: "
                    +
                    ex.Message);
            }
        }

        private void CopyNewLeaderOrder(
            Order leaderOrder)
        {
            List<FollowerSetting> followers =
                GetEnabledFollowersThreadSafe();

            if (followers.Count == 0)
                return;

            List<FollowerOrderRecord> records =
                new List<FollowerOrderRecord>();

            LeaderExecutionTracker tracker =
                new LeaderExecutionTracker();

            lock (syncLock)
            {
                if (
                    !executionTrackers.ContainsKey(
                        leaderOrder))
                {
                    executionTrackers.Add(
                        leaderOrder,
                        tracker);
                }
                else
                {
                    tracker =
                        executionTrackers[
                            leaderOrder];
                }
            }

            foreach (
                FollowerSetting follower
                in followers)
            {
                try
                {
                    int multiplier =
                        GetMultiplier(
                            follower);

                    int followerQuantity =
                        Math.Max(
                            1,
                            leaderOrder.Quantity
                            *
                            multiplier);

                    string followerOco =
                        GetFollowerOco(
                            follower.Account,
                            leaderOrder.Oco);

                    string orderName =
                        "P4619TCII";

                    Order followerOrder =
                        follower.Account.CreateOrder(
                            leaderOrder.Instrument,
                            leaderOrder.OrderAction,
                            leaderOrder.OrderType,
                            OrderEntry.Manual,
                            leaderOrder.TimeInForce,
                            followerQuantity,
                            leaderOrder.LimitPrice,
                            leaderOrder.StopPrice,
                            followerOco,
                            orderName,
                            leaderOrder.Gtd,
                            null);

                    FollowerOrderRecord record =
                        new FollowerOrderRecord
                        {
                            Account =
                                follower.Account,

                            Order =
                                followerOrder,

                            LeaderOrder =
                                leaderOrder,

                            LastLeaderQuantity =
                                leaderOrder.Quantity,

                            LastLeaderLimit =
                                leaderOrder.LimitPrice,

                            LastLeaderStop =
                                leaderOrder.StopPrice,

                            MatchedLeaderExecutionCount =
                                0
                        };

                    lock (syncLock)
                    {
                        followerOrderLookup[
                            followerOrder] =
                                record;

                        tracker.Followers.Add(
                            record);
                    }

                    follower.Account.Submit(
                        new[]
                        {
                            followerOrder
                        });

                    records.Add(
                        record);

                    LogThreadSafe(
                        "COPIED "
                        +
                        leaderOrder.OrderAction
                        +
                        " "
                        +
                        leaderOrder.Quantity
                        +
                        " "
                        +
                        leaderOrder.Instrument.FullName
                        +
                        " -> "
                        +
                        follower.Account.Name
                        +
                        " qty "
                        +
                        followerQuantity);
                }

                catch (Exception ex)
                {
                    LogThreadSafe(
                        "SUBMIT ERROR "
                        +
                        follower.Account.Name
                        +
                        ": "
                        +
                        ex.Message);
                }
            }

            lock (syncLock)
            {
                if (
                    !copiedOrders.ContainsKey(
                        leaderOrder))
                {
                    copiedOrders.Add(
                        leaderOrder,
                        records);
                }
            }
        }

        private void LeaderAccount_ExecutionUpdate(
            object sender,
            ExecutionEventArgs e)
        {
            long leaderTicks =
                Stopwatch.GetTimestamp();

            if (
                !copierRunning
                ||
                e == null
                ||
                e.Execution == null
                ||
                e.Execution.Order == null)
            {
                return;
            }

            Order leaderOrder =
                e.Execution.Order;

            LeaderExecutionTracker tracker;

            lock (syncLock)
            {
                if (
                    !executionTrackers.TryGetValue(
                        leaderOrder,
                        out tracker))
                {
                    return;
                }

                tracker.LeaderExecutionTicks.Add(
                    leaderTicks);

                foreach (
                    FollowerOrderRecord record
                    in tracker.Followers.ToList())
                {
                    TryMatchPendingFollowerExecution(
                        tracker,
                        record);
                }
            }
        }

        private void FollowerAccount_ExecutionUpdate(
            object sender,
            ExecutionEventArgs e)
        {
            long followerTicks =
                Stopwatch.GetTimestamp();

            if (
                !copierRunning
                ||
                e == null
                ||
                e.Execution == null
                ||
                e.Execution.Order == null)
            {
                return;
            }

            Order followerOrder =
                e.Execution.Order;

            lock (syncLock)
            {
                FollowerOrderRecord record;

                if (
                    !followerOrderLookup.TryGetValue(
                        followerOrder,
                        out record)
                    ||
                    record == null
                    ||
                    record.LeaderOrder == null)
                {
                    return;
                }

                LeaderExecutionTracker tracker;

                if (
                    !executionTrackers.TryGetValue(
                        record.LeaderOrder,
                        out tracker))
                {
                    return;
                }

                if (
                    record.MatchedLeaderExecutionCount
                    <
                    tracker.LeaderExecutionTicks.Count)
                {
                    MatchFollowerExecution(
                        tracker,
                        record,
                        followerTicks);
                }
                else
                {
                    record.PendingFollowerExecutionTicks.Enqueue(
                        followerTicks);
                }
            }
        }
        private void TryMatchPendingFollowerExecution(
            LeaderExecutionTracker tracker,
            FollowerOrderRecord record)
        {
            if (tracker == null || record == null)
                return;

            while (
                record.PendingFollowerExecutionTicks.Count > 0
                &&
                record.MatchedLeaderExecutionCount <
                    tracker.LeaderExecutionTicks.Count)
            {
                long followerTicks =
                    record.PendingFollowerExecutionTicks.Dequeue();

                MatchFollowerExecution(
                    tracker,
                    record,
                    followerTicks);
            }
        }

        private void MatchFollowerExecution(
            LeaderExecutionTracker tracker,
            FollowerOrderRecord record,
            long followerTicks)
        {
            int leaderIndex =
                record.MatchedLeaderExecutionCount;

            if (
                leaderIndex < 0
                ||
                leaderIndex >= tracker.LeaderExecutionTicks.Count)
            {
                return;
            }

            long leaderTicks =
                tracker.LeaderExecutionTicks[leaderIndex];

            record.MatchedLeaderExecutionCount++;

            double latencyMs =
                ((double)(followerTicks - leaderTicks)
                / Stopwatch.Frequency) * 1000.0;

            RecordLatency(
                record.Account.Name,
                latencyMs);
        }

        private void RecordLatency(
            string accountName,
            double latencyMs)
        {
            latencyFillCount++;

            latencyLastMs =
                latencyMs;

            latencyTotalMs +=
                latencyMs;

            if (latencyMs > latencyMaxMs)
            {
                latencyMaxMs =
                    latencyMs;
            }

            LogThreadSafe(
                "LATENCY "
                + accountName
                + ": "
                + latencyMs.ToString("0.000")
                + " ms");

            UpdateLatencyDisplayThreadSafe();
        }

        private void ResetLatencyCounters()
        {
            latencyFillCount = 0;
            latencyLastMs = 0.0;
            latencyTotalMs = 0.0;
            latencyMaxMs = 0.0;

            UpdateLatencyDisplay();
        }

        private void UpdateLatencyDisplayThreadSafe()
        {
            if (Dispatcher.CheckAccess())
            {
                UpdateLatencyDisplay();
            }
            else
            {
                Dispatcher.BeginInvoke(
                    new Action(UpdateLatencyDisplay));
            }
        }

        private void UpdateLatencyDisplay()
        {
            if (
                latencyLastText == null
                ||
                latencyAvgText == null
                ||
                latencyMaxText == null
                ||
                latencyFillsText == null)
            {
                return;
            }

            if (latencyFillCount <= 0)
            {
                latencyLastText.Text =
                    "LAST: --";

                latencyAvgText.Text =
                    "AVG: --";

                latencyMaxText.Text =
                    "MAX: --";

                latencyFillsText.Text =
                    "FILLS: 0";

                return;
            }

            latencyLastText.Text =
                "LAST: "
                + latencyLastMs.ToString("0.000")
                + " ms";

            latencyAvgText.Text =
                "AVG: "
                + (latencyTotalMs / latencyFillCount)
                    .ToString("0.000")
                + " ms";

            latencyMaxText.Text =
                "MAX: "
                + latencyMaxMs.ToString("0.000")
                + " ms";

            latencyFillsText.Text =
                "FILLS: "
                + latencyFillCount;
        }

        private void ChangeFollowerOrders(
            Order leaderOrder)
        {
            List<FollowerOrderRecord> records;

            lock (syncLock)
            {
                if (
                    !copiedOrders.TryGetValue(
                        leaderOrder,
                        out records))
                {
                    return;
                }

                records =
                    records.ToList();
            }

            foreach (
                FollowerOrderRecord record
                in records)
            {
                if (
                    record == null
                    ||
                    record.Order == null
                    ||
                    record.Account == null)
                {
                    continue;
                }

                try
                {
                    if (IsTerminal(record.Order.OrderState))
                        continue;

                    FollowerSetting setting;

                    if (
                        !followerSettings.TryGetValue(
                            record.Account.Name,
                            out setting))
                    {
                        continue;
                    }

                    int multiplier =
                        GetMultiplier(setting);

                    int desiredQuantity =
                        Math.Max(
                            1,
                            leaderOrder.Quantity * multiplier);

                    bool changed =
                        false;

                    if (
                        record.LastLeaderQuantity !=
                        leaderOrder.Quantity)
                    {
                        record.Order.QuantityChanged =
                            desiredQuantity;

                        record.LastLeaderQuantity =
                            leaderOrder.Quantity;

                        changed =
                            true;
                    }

                    if (
                        record.LastLeaderLimit !=
                        leaderOrder.LimitPrice)
                    {
                        record.Order.LimitPriceChanged =
                            leaderOrder.LimitPrice;

                        record.LastLeaderLimit =
                            leaderOrder.LimitPrice;

                        changed =
                            true;
                    }

                    if (
                        record.LastLeaderStop !=
                        leaderOrder.StopPrice)
                    {
                        record.Order.StopPriceChanged =
                            leaderOrder.StopPrice;

                        record.LastLeaderStop =
                            leaderOrder.StopPrice;

                        changed =
                            true;
                    }

                    if (changed)
                    {
                        record.Account.Change(
                            new[]
                            {
                                record.Order
                            });

                        LogThreadSafe(
                            "CHANGED "
                            + record.Account.Name
                            + " "
                            + leaderOrder.Instrument.FullName);
                    }
                }
                catch (Exception ex)
                {
                    LogThreadSafe(
                        "CHANGE ERROR "
                        + record.Account.Name
                        + ": "
                        + ex.Message);
                }
            }
        }

        private void CancelFollowerOrders(
            Order leaderOrder)
        {
            List<FollowerOrderRecord> records;

            lock (syncLock)
            {
                if (
                    !copiedOrders.TryGetValue(
                        leaderOrder,
                        out records))
                {
                    return;
                }

                records =
                    records.ToList();
            }

            foreach (
                FollowerOrderRecord record
                in records)
            {
                if (
                    record == null
                    ||
                    record.Order == null
                    ||
                    record.Account == null)
                {
                    continue;
                }

                try
                {
                    if (IsTerminal(record.Order.OrderState))
                        continue;

                    record.Account.Cancel(
                        new[]
                        {
                            record.Order
                        });

                    LogThreadSafe(
                        "CANCELLED follower order: "
                        + record.Account.Name
                        + " "
                        + leaderOrder.Instrument.FullName);
                }
                catch (Exception ex)
                {
                    LogThreadSafe(
                        "CANCEL ERROR "
                        + record.Account.Name
                        + ": "
                        + ex.Message);
                }
            }
        }

        private string GetFollowerOco(
            Account follower,
            string leaderOco)
        {
            if (
                follower == null
                ||
                string.IsNullOrEmpty(leaderOco))
            {
                return string.Empty;
            }

            string key =
                follower.Name + "|" + leaderOco;

            lock (syncLock)
            {
                string followerOco;

                if (
                    followerOcoMap.TryGetValue(
                        key,
                        out followerOco))
                {
                    return followerOco;
                }

                followerOco =
                    "P4619_"
                    + Guid.NewGuid().ToString("N");

                followerOcoMap[key] =
                    followerOco;

                return followerOco;
            }
        }

